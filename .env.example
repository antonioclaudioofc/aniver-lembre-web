# Copy this file to .env and fill in real values. .env is gitignored and must never be committed.

# PostgreSQL connection string (e.g. from Neon). Leave unset to fall back to sqlite3 locally.
DATABASE_URL=postgres://user:password@host:port/dbname

# Django secret key. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Required in production; falls back to an insecure dev-only key if unset.
SECRET_KEY=

# Set to True only for local development. Must be False (or unset) in production.
DEBUG=True

# --- Birthday reminder emails ---

# Defaults to printing emails to the console (safe for local dev).
# To actually send emails via Gmail SMTP, set:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
# Full Gmail address. Password must be a 16-char "App Password" generated at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification enabled),
# NOT your normal Gmail password.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Secret token required to call /reminders/run-check/ (e.g. from cron-job.org).
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=

# Public URL of the deployed app, used for the "Abrir AniverLembre" link inside
# reminder emails (there's no browser request when the cron endpoint fires).
SITE_URL=http://127.0.0.1:8000

